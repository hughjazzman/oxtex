\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=white dot] (1) at (0, -1.5) {$\cdot$};
		\node [style=white dot] (2) at (0, 0) {$\cdot$};
		\node [style=map] (3) at (1.5, 1.5) {$f_i$};
		\node [style=white phase dot] (4) at (1.5, 3.25) {$\pi$};
		\node [style=none] (5) at (-1.5, 1.5) {};
		\node [style=none] (6) at (-1.5, 3.75) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=simple] (2) to (1.center);
		\draw [style=simple, bend left=45] (3.center) to (2);
		\draw [style=simple, bend right=45] (5.center) to (2);
		\draw [style=simple] (5.center) to (6.center);
		\draw [style=simple] (4) to (3.center);
	\end{pgfonlayer}
\end{tikzpicture}
