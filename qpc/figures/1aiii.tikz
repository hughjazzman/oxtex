\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=white phase ddot] (0) at (0, -0.5) {$j\pi$};
		\node [style=white phase ddot] (2) at (0, -2) {$(-1)^k \frac{\pi}{2}$};
		\node [style=white phase ddot] (5) at (0, 1) {$|j-k|\pi$};
		\node [style=none] (6) at (0, -3.5) {};
		\node [style=none] (7) at (0, 2.5) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=thick] (5) to (7.center);
		\draw [style=thick] (5) to (0);
		\draw [style=thick] (0) to (2);
		\draw [style=thick] (2) to (6.center);
	\end{pgfonlayer}
\end{tikzpicture}
