\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=point] (1) at (2, -1) {$f_a(i)$};
		\node [style=white phase dot] (3) at (2, 0.5) {$\pi$};
		\node [style=point] (4) at (-2, -1) {$i\cdot j$};
		\node [style=white phase dot] (5) at (-2, 0.5) {$\pi$};
		\node [style=point] (6) at (0, -1) {$j$};
		\node [style=none] (7) at (0, 0.5) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=simple] (3) to (1);
		\draw [style=simple] (7.center) to (6);
		\draw [style=simple] (5) to (4);
	\end{pgfonlayer}
\end{tikzpicture}
