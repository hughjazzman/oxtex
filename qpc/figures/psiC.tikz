\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=white ddot] (3) at (1, -1) {};
		\node [style=white ddot] (4) at (-3, -1) {};
		\node [style=gray ddot] (7) at (-1, -1) {};
		\node [style=gray ddot] (10) at (3, -1) {};
		\node [style=none] (11) at (-3, 1) {};
		\node [style=none] (12) at (-1, 1) {};
		\node [style=none] (13) at (1, 1) {};
		\node [style=none] (14) at (3, 1) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=thick] (4) to (7);
		\draw [style=thick] (7) to (3);
		\draw [style=thick] (3) to (10);
		\draw [style=thick] (11.center) to (4);
		\draw [style=thick] (12.center) to (7);
		\draw [style=thick] (13.center) to (3);
		\draw [style=thick] (14.center) to (10);
