\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=point] (0) at (-1, -1) {$x$};
		\node [style=point] (1) at (1, -1) {$f_i(x)$};
		\node [style=none] (2) at (-1, 0.5) {};
		\node [style=white phase dot] (3) at (1, 0.5) {$\pi$};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=simple] (2.center) to (0);
		\draw [style=simple] (3) to (1);
	\end{pgfonlayer}
\end{tikzpicture}
