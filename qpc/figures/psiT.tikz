\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=white phase ddot] (2) at (-1, -1) {$\frac{\pi}{4}$};
		\node [style=grey ddot] (3) at (1, -1) {};
		\node [style=none] (4) at (-1, 1) {};
		\node [style=none] (5) at (1, 1) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=thick] (2) to (3);
		\draw [style=thick] (4.center) to (2);
		\draw [style=thick] (5.center) to (3);
	\end{pgfonlayer}
\end{tikzpicture}
