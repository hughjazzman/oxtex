\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-1, 1) {};
		\node [style=none] (1) at (1, 1) {};
		\node [style=none] (2) at (1, -1) {};
		\node [style=none] (3) at (-1, -1) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=small dash] (0.center) to (3.center);
		\draw [style=small dash] (3.center) to (2.center);
		\draw [style=small dash] (2.center) to (1.center);
		\draw [style=small dash] (1.center) to (0.center);
	\end{pgfonlayer}
\end{tikzpicture}
