
\begin{tikzpicture}
    \begin{pgfonlayer}{nodelayer}
        \node [style=Z phase dot] (0) at (0.00, 0.00) {$\frac{\pi}{2}$};
        \node [style=Z phase dot] (1) at (0.00, -1.00) {$\frac{3\pi}{4}$};
        \node [style=X dot] (2) at (1.00, -1.00) {};
        \node [style=Z phase dot] (3) at (2.00, -1.00) {$\frac{\pi}{4}$};
        \node [style=X dot] (4) at (3.00, -1.00) {};
        \node [style=X dot] (5) at (2.00, 0.00) {};
        \node [style=Z phase dot] (6) at (3.00, 0.00) {$\frac{\pi}{4}$};
        \node [style=X phase dot] (7) at (1.00, -2.00) {$\frac{\pi}{2}$};
        \node [style=Z dot] (8) at (3.00, -2.00) {};
        \node [style=Z phase dot] (9) at (4.00, 0.00) {$\frac{\pi}{4}$};
        \node [style=X dot] (10) at (4.00, -2.00) {};
        \node [style=Z phase dot] (11) at (5.00, -2.00) {$\frac{\pi}{4}$};
    \end{pgfonlayer}
    \begin{pgfonlayer}{edgelayer}
        \draw (0) to (2);
        \draw (0) to (4);
        \draw (0) to (7);
        \draw (1) to (2);
        \draw (2) to (3);
        \draw (3) to (4);
        \draw (4) to (8);
        \draw (4) to (6);
        \draw (4) to (9);
        \draw (5) to (6);
        \draw (7) to (8);
        \draw (8) to (10);
        \draw (9) to (10);
        \draw (10) to (11);
    \end{pgfonlayer}
\end{tikzpicture}
