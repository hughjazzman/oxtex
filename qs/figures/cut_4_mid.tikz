
\begin{tikzpicture}
    \begin{pgfonlayer}{nodelayer}
        \node [style=Z phase dot] (1) at (0.00, -1.00) {$\frac{3\pi}{4}$};
        \node [style=Z phase dot] (3) at (2.00, -1.00) {$\frac{\pi}{4}$};
        \node [style=Z dot] (4) at (3.00, -1.00) {};
        \node [style=Z dot] (5) at (2.00, 0.00) {};
        \node [style=Z phase dot] (6) at (3.00, 0.00) {$\frac{\pi}{4}$};
        \node [style=Z phase dot] (9) at (4.00, 0.00) {$\frac{7\pi}{4}$};
        \node [style=Z phase dot] (11) at (5.00, -2.00) {$\frac{7\pi}{4}$};
    \end{pgfonlayer}
    \begin{pgfonlayer}{edgelayer}
        \draw [style=hadamard edge] (1) to (4);
        \draw [style=hadamard edge] (1) to (9);
        \draw [style=hadamard edge] (1) to (11);
        \draw [style=hadamard edge] (3) to (9);
        \draw [style=hadamard edge] (3) to (11);
        \draw [style=hadamard edge] (4) to (6);
        \draw [style=hadamard edge] (4) to (11);
        \draw [style=hadamard edge] (5) to (6);
        \draw [style=hadamard edge] (9) to (11);
    \end{pgfonlayer}
\end{tikzpicture}
