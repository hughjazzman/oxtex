\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=Z phase dot] (0) at (0, 0) {$\frac{\pi}{4}$};
		\node [style=Z phase dot] (8) at (2, 0) {$\frac{7\pi}{4}$};
		\node [style=Z phase dot] (10) at (1, -1) {$\frac{3\pi}{4}$};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=hadamard edge] (0) to (8);
		\draw [style=hadamard edge] (0) to (10);
		\draw [style=hadamard edge] (8) to (10);
	\end{pgfonlayer}
\end{tikzpicture}
