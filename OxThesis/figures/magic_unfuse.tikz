\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=Z phase dot] (0) at (-3, 0) {$(2k+1)\frac{\pi}{4}$};
		\node [style=Z phase dot] (1) at (3, 0) {$k\frac{\pi}{2}$};
		\node [style=Z phase dot] (2) at (2.5, 1) {$\frac{\pi}{4}$};
		\node [style=none] (3) at (-1, 1) {};
		\node [style=none] (4) at (-1, -1) {};
		\node [style=none] (5) at (-5, 1) {};
		\node [style=none] (6) at (-5, -1) {};
		\node [style=none] (7) at (1, 1) {};
		\node [style=none] (8) at (1, -1) {};
		\node [style=none] (9) at (5, -1) {};
		\node [style=none] (10) at (5, 1) {};
		\node [style=none] (11) at (-4.75, 0.25) {$\vdots$};
		\node [style=none] (12) at (-1.25, 0.25) {$\vdots$};
		\node [style=none] (13) at (1.25, 0.25) {$\vdots$};
		\node [style=none] (14) at (4.75, 0.25) {$\vdots$};
		\node [style=none] (15) at (0, 0) {$=$};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (5.center) to (0);
		\draw (6.center) to (0);
		\draw (0) to (3.center);
		\draw (0) to (4.center);
		\draw (7.center) to (1);
		\draw (8.center) to (1);
		\draw (1) to (9.center);
		\draw (1) to (10.center);
		\draw [bend left] (2) to (1);
	\end{pgfonlayer}
\end{tikzpicture}
