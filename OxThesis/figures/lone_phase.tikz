		\node [style=none] (6) at (-4.25, 0.25) {$\vdots$};
		\node [style=Z phase dot] (8) at (7, -1.5) {$(2k_n+1)\frac{\pi}{4}+a\pi$};
		\node [style=Z phase dot] (9) at (7, 1.5) {$(2k_1+1)\frac{\pi}{4}+a\pi$};
