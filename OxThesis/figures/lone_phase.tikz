\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=Z phase dot] (0) at (-3, 0) {$\frac{\pi}{4}$};
		\node [style=Z phase dot] (1) at (-4.5, -1.5) {$\frac{\pi}{4}$};
		\node [style=Z phase dot] (2) at (-4.5, 1.5) {$\frac{\pi}{4}$};
		\node [style=none] (3) at (-2, -1) {};
		\node [style=none] (4) at (-2, 1) {};
		\node [style=none] (5) at (-2.25, 0.25) {$\vdots$};
		\node [style=none] (6) at (-4.25, 0.25) {$\vdots$};
		\node [style=Z phase dot] (8) at (2.5, -1.5) {$\frac{\pi}{4}+a\pi$};
		\node [style=Z phase dot] (9) at (2.5, 1.5) {$\frac{\pi}{4}+a\pi$};
		\node [style=none] (10) at (6.5, -1) {};
		\node [style=none] (11) at (6.5, 1) {};
		\node [style=none] (12) at (6, 0.25) {$\vdots$};
		\node [style=none] (13) at (2.5, 0.25) {$\vdots$};
		\node [style=X phase dot] (14) at (5.25, -1) {$a\pi$};
		\node [style=X phase dot] (15) at (5.25, 1) {$a\pi$};
		\node [style=none] (16) at (0, 0) {$\longrightarrow$};
		\node [style=none] (17) at (0, 1) {\CutRule};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=hadamard edge] (1) to (0);
		\draw [style=hadamard edge] (0) to (2);
		\draw (0) to (3.center);
		\draw (0) to (4.center);
		\draw (14) to (10.center);
		\draw (15) to (11.center);
	\end{pgfonlayer}
