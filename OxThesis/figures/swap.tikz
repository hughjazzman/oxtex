\begin{tikzpicture}
	\path [use as bounding box] (-1.25,-1) rectangle (1.25,1.5);
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-0.75, 0.75) {};
		\node [style=none] (1) at (0.75, 0.75) {};
		\node [style=none] (2) at (-0.75, -0.75) {};
