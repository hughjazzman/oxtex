		\node [style=none] (8) at (1, -0.75) {};
		\node [style=none] (9) at (1, 0.75) {};
		\node [style=none] (10) at (-1, -0.75) {};
		\node [style=none] (11) at (-1, 0.75) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [in=180, out=0, looseness=1.00] (0.center) to (3.center);
