\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=gate] (0) at (-2, 0) {$U_j^{\dagger}$};
		\node [style=gate] (1) at (0, 0) {$P_j$};
		\node [style=gate] (2) at (2, 0) {$U_j$};
		\node [style=none] (3) at (3.5, 0) {};
