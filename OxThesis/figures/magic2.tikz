\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=Z phase dot] (0) at (-2.75, 0) {$\frac{\pi}{2}$};
		\node [style=X phase dot] (1) at (1.75, 0) {$\pi$};
		\node [style=none] (2) at (3.5, 1) {};
		\node [style=none] (3) at (3.5, -1) {};
		\node [style=none] (4) at (-1, 1) {};
		\node [style=none] (5) at (-1, -1) {};
		\node [style=none] (6) at (0.25, 0) {$+ e^{i\frac{\pi}{4}}$};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [bend left=15] (0) to (4.center);
		\draw [bend right=15] (0) to (5.center);
		\draw [bend left=15] (1) to (2.center);
		\draw [bend right=15] (1) to (3.center);
	\end{pgfonlayer}
\end{tikzpicture}
